{
  "name": "nginx-conf-doctor",
  "publisher": "buddham-hq",
  "displayName": "Hun Nginx 설정 닥터",
  "description": "훈(Hun) 프로젝트 - nginx 설정의 컨텍스트를 읽는 구문 강조, 진단, 자동완성, hover 문서 | Context-aware diagnostics, IntelliSense and hover docs for nginx configuration files.",
  "version": "0.0.3",
  "license": "MIT",
  "author": {
    "name": "Kim Bum Jun (ViVaKR)",
    "url": "https://github.com/ViVaKR"
  },
  "icon": "icon_256.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "nginx",
    "nginx.conf",
    "conf",
    "config",
    "lint",
    "linter",
    "diagnostics",
    "intellisense",
    "autocomplete",
    "hover",
    "syntax-highlighting",
    "sites-available",
    "conf.d",
    "lua"
  ],
  "activationEvents": [
    "onLanguage:nginx"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ViVaKR/nginx-conf-doctor.git"
  },
  "homepage": "https://github.com/ViVaKR/nginx-conf-doctor#readme",
  "bugs": {
    "url": "https://github.com/ViVaKR/nginx-conf-doctor/issues"
  },
  "qna": "https://github.com/ViVaKR/nginx-conf-doctor/issues",
  "contributes": {
    "languages": [
      {
        "id": "nginx",
        "aliases": [
          "Nginx",
          "nginx"
        ],
        "extensions": [
          ".nginx",
          ".nginx.conf"
        ],
        "filenames": [
          "nginx.conf",
          "mime.types",
          "fastcgi_params",
          "scgi_params",
          "uwsgi_params"
        ],
        "filenamePatterns": [
          "**/nginx/**/*.conf",
          "**/conf.d/*.conf",
          "**/sites-available/*",
          "**/sites-enabled/*",
          "**/snippets/*.conf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nginx",
        "scopeName": "source.nginx",
        "path": "./syntaxes/nginx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.lua": "lua"
        }
      }
    ],
    "configuration": {
      "title": "Nginx Conf Doctor",
      "properties": {
        "nginx-conf-doctor.extraDirectives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "서드파티 모듈 등 이 확장이 모르는 지시어 이름. 여기 적으면 '알 수 없는 지시어' 경고가 사라집니다.",
          "markdownDescription": "서드파티 모듈 등 이 확장이 모르는 지시어 이름. 여기 적으면 '알 수 없는 지시어' 경고가 사라집니다."
        },
        "nginx-conf-doctor.contextSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "description": "'이 위치에서는 쓸 수 없는 지시어' 경고의 표시 수준. off 로 끌 수 있습니다.",
          "markdownDescription": "'이 위치에서는 쓸 수 없는 지시어' 경고의 표시 수준. off 로 끌 수 있습니다."
        },
        "nginx-conf-doctor.unknownDirectiveSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "description": "알 수 없는 지시어의 표시 수준. off 로 끌 수 있습니다.",
          "markdownDescription": "알 수 없는 지시어의 표시 수준. off 로 끌 수 있습니다."
        }
      }
    }
  },
  "scripts": {
    "gen:grammar": "node scripts/gen-grammar.js",
    "gen:directives": "node scripts/gen-directives.js",
    "check": "node scripts/check-conf.js",
    "mutate": "node scripts/mutate-check.js",
    "test:unit": "node --test test/unit/*.spec.js",
    "lint": "eslint .",
    "test": "vscode-test",
    "package": "vsce package",
    "vscode:prepublish": "npm run test:unit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^10.5.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
