{
  "name": "nginx-conf-doctor",
  "displayName": "nginx-conf-doctor",
  "publisher": "buddham-hq",
  "description": "컨텍스트 인식 진단·자동완성·hover 문서를 제공하는 nginx 설정 확장",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "nginx",
    "conf",
    "lint",
    "diagnostics",
    "syntax-highlighting"
  ],
  "activationEvents": [
    "onLanguage:nginx"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nginx",
        "aliases": [
          "Nginx",
          "nginx"
        ],
        "extensions": [
          ".nginx",
          ".nginx.conf"
        ],
        "filenames": [
          "nginx.conf",
          "mime.types",
          "fastcgi_params",
          "scgi_params",
          "uwsgi_params"
        ],
        "filenamePatterns": [
          "**/nginx/**/*.conf",
          "**/conf.d/*.conf",
          "**/sites-available/*",
          "**/sites-enabled/*",
          "**/snippets/*.conf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nginx",
        "scopeName": "source.nginx",
        "path": "./syntaxes/nginx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.lua": "lua"
        }
      }
    ],
    "configuration": {
      "title": "Nginx Conf Doctor",
      "properties": {
        "nginx-conf-doctor.extraDirectives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "서드파티 모듈 등 이 확장이 모르는 지시어 이름. 여기 적으면 '알 수 없는 지시어' 경고가 사라집니다."
        },
        "nginx-conf-doctor.unknownDirectiveSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "description": "알 수 없는 지시어의 표시 수준. off 로 끌 수 있습니다."
        }
      }
    }
  },
  "scripts": {
    "gen:grammar": "node scripts/gen-grammar.js",
    "gen:directives": "node scripts/gen-directives.js",
    "check": "node scripts/check-conf.js",
    "mutate": "node scripts/mutate-check.js",
    "test:unit": "node --test test/unit/*.spec.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
