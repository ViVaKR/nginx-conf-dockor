{
  "comment": "자동 생성 파일 — 직접 수정하지 마세요. `npm run gen:grammar` 로 재생성.",
  "name": "Nginx",
  "scopeName": "source.nginx",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#string-double"
    },
    {
      "include": "#string-single"
    },
    {
      "include": "#lua-block"
    },
    {
      "include": "#block-directives"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.nginx",
      "match": "(?<=^|[\\s;{}])#.*$"
    },
    "string-double": {
      "name": "string.quoted.double.nginx",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nginx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nginx"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nginx",
          "match": "\\\\."
        },
        {
          "include": "#variables"
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.nginx",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nginx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nginx"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nginx",
          "match": "\\\\."
        },
        {
          "include": "#variables"
        }
      ]
    },
    "lua-block": {
      "begin": "(?:^|(?<=[;{}]))[ \\t]*(\\w*_by_lua_block)[ \\t]*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.block.nginx"
        },
        "2": {
          "name": "punctuation.section.block.begin.nginx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.nginx"
        }
      },
      "name": "meta.embedded.block.lua",
      "patterns": [
        {
          "include": "#lua-nested"
        },
        {
          "include": "source.lua"
        }
      ]
    },
    "lua-nested": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#lua-nested"
        },
        {
          "include": "source.lua"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.nginx",
          "match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"
        },
        {
          "name": "variable.other.nginx",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.capture.nginx",
          "match": "\\$[0-9]+"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.nginx",
      "match": "(?<=^|[\\s(])(?:!~\\*|!~|~\\*|~|\\^~|!=|=|!?-[fdex])(?=\\s)"
    },
    "constants": {
      "name": "constant.language.nginx",
      "match": "(?<![\\w$./-])(?:on|off)(?![\\w./-])"
    },
    "numbers": {
      "name": "constant.numeric.nginx",
      "match": "(?<![\\w$./-])\\d+(?:\\.\\d+)?(?:ms|[smhdwMy]|[kKmMgG]|r/[sm])?(?![\\w./-])"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.nginx",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.nginx",
          "match": "\\}"
        },
        {
          "name": "punctuation.terminator.statement.nginx",
          "match": ";"
        }
      ]
    },
    "block-directives": {
      "match": "(?:^|(?<=[;{}]))[ \\t]*(oidc_provider|otel_exporter|split_clients|limit_except|acme_issuer|charset_map|location|upstream|num_map|events|server|stream|match|types|http|mail|mgmt|geo|map|if)(?![A-Za-z0-9_])",
      "captures": {
        "1": {
          "name": "keyword.control.block.nginx"
        }
      }
    },
    "directives": {
      "match": "(?:^|(?<=[;{}]))[ \\t]*(js_fetch_max_response_buffer_size|zone_sync_ssl_trusted_certificate|zone_sync_connect_retry_interval|fastcgi_cache_background_update|memcached_next_upstream_timeout|quic_active_connection_id_limit|fastcgi_cache_max_range_offset|proxy_headers_hash_bucket_size|fastcgi_next_upstream_timeout|memcached_next_upstream_tries|proxy_cache_background_update|proxy_ssl_trusted_certificate|server_names_hash_bucket_size|subrequest_output_buffer_size|uwsgi_cache_background_update|uwsgi_ssl_trusted_certificate|zone_sync_ssl_certificate_key|client_body_in_single_buffer|fastcgi_pass_request_headers|fastcgi_temp_file_write_size|grpc_ssl_trusted_certificate|http2_max_concurrent_streams|http3_max_concurrent_streams|js_fetch_trusted_certificate|js_load_stream_native_module|proxy_cache_max_range_offset|scgi_cache_background_update|ssl_object_cache_inheritable|tunnel_next_upstream_timeout|uwsgi_cache_max_range_offset|fastcgi_ignore_client_abort|fastcgi_next_upstream_tries|http2_max_concurrent_pushes|js_fetch_keepalive_requests|large_client_header_buffers|proxy_headers_hash_max_size|proxy_next_upstream_timeout|proxy_ssl_certificate_cache|scgi_cache_max_range_offset|ssl_certificate_compression|uninitialized_variable_warn|uwsgi_next_upstream_timeout|uwsgi_ssl_certificate_cache|zone_sync_ssl_password_file|auth_http_pass_client_cert|fastcgi_cache_lock_timeout|fastcgi_max_temp_file_size|grpc_next_upstream_timeout|grpc_ssl_certificate_cache|js_fetch_keepalive_timeout|js_load_http_native_module|memcached_socket_keepalive|proxy_pass_request_headers|proxy_temp_file_write_size|scgi_next_upstream_timeout|server_names_hash_max_size|tunnel_next_upstream_tries|uwsgi_pass_request_headers|uwsgi_temp_file_write_size|variables_hash_bucket_size|zone_sync_recv_buffer_size|zone_sync_ssl_conf_command|zone_sync_ssl_verify_depth|chunked_transfer_encoding|client_header_buffer_size|fastcgi_busy_buffers_size|fastcgi_pass_request_body|fastcgi_request_buffering|google_perftools_pr